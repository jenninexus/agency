# AI Agent Agency — Environment Configuration
# Copy this to .env and update paths for your project
#
# Usage:
#   bash:        source .env
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^#][^=]*)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#
# Read by: scripts/_audit-common.ps1 (PROJECT_ROOT, AGENT_CONFIG, AUDITS_DIR, AGENTS_DIR)
#          scripts/mcp-server.js    (AGENCY_PROJECT)
# The other paths are conventions for your own audit scripts.
#
# Portrait generation is optional and not this repo's runtime.
# Use https://github.com/jenninexus/gen-ai (GROK_API_KEY in that clone's .env).
# Do not put xAI secrets in this public agency clone.

# ── Project paths ─────────────────────────────────────────────────────────────

# Optional absolute paths. Blank entries use the audit helper's defaults.
# The helper reads literal values, so use absolute paths instead of variable references.
PROJECT_ROOT=

# Agency repo root (standalone clone or submodule path)
AGENCY_DIR=

# ── Source directories ─────────────────────────────────────────────────────────

CSS_SRC_DIR=
JS_SRC_DIR=
DOCS_DIR=

# ── Output / public directories ────────────────────────────────────────────────

PUBLIC_DIR=
RESOURCES_DIR=

# ── Agent system ───────────────────────────────────────────────────────────────

# Agent profiles directory
AGENTS_DIR=

# Agent registry — copy mcp.example.json → mcp.json and customize (default if unset).
# .vscode/mcp.json is only the VS Code server entry, not the registry.
AGENT_CONFIG=

# Default project for the MCP server's overlay lookups (projects/<name>/).
# Same as passing --project <name>. Leave empty to list available projects.
AGENCY_PROJECT=

# Audit output directory (gitignored — generated per run)
AUDITS_DIR=

# Audit scripts directory
SCRIPTS_DIR=

# ── Optional Grok / xAI (names only — values live in gen-ai/.env) ─────────────
# Inference: console.x.ai → API Keys. Billing: Settings → Management Keys.
# This repo does not call xAI. Point generate.mjs at agents/characters.yaml.
# Names used by gen-ai: GROK_API_KEY, XAI_MGMT_KEY, XAI_TEAM_ID.
